# ============================================================
# Medical Chatbot RAG v2.0.0 — Environment Variables
# ============================================================
# Copy this file to .env and fill in your API keys.
# All API keys are free tier — no credit card required.
# ============================================================

# === REQUIRED ===

# Pinecone: Vector database for document search
# Get key: https://app.pinecone.io
PINECONE_API_KEY=your-pinecone-api-key

# OpenRouter: Primary LLM provider (gpt-oss-120b:free)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Flask: Secret key for session encryption
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-string-in-production

# === EMBEDDINGS (at least one required) ===

# Jina AI: only embedding provider for the 1024-d Pinecone index
# Get key: https://jina.ai/ → API Dashboard
JINA_API_KEY=your-jina-api-key

# HuggingFace is not used. A 384-d model cannot share the Jina index.

# === LLM FALLBACK (optional) ===

# Groq: Backup LLM provider (gpt-oss-120b, 30 req/min free)
# Get key: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# === DATABASE (production/Vercel only) ===

# Neon PostgreSQL: Serverless Postgres
# Get connection string: https://console.neon.tech
# IMPORTANT: Use the -pooler endpoint for serverless
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# === DEPLOYMENT ===

# Environment: 'development' (SQLite) or 'production' (PostgreSQL)
FLASK_ENV=development

# Your deployed URL (used in OpenRouter HTTP-Referer header)
# Production: https://dwa21x631l5fr.cloudfront.net
APP_URL=http://localhost:8080

# === RATE LIMITING (production, optional) ===

# In-memory rate limiting works for dev but NOT for Vercel serverless.
# For production, set one of these to Upstash Redis (rediss:// or redis://):
# RATELIMIT_STORAGE_URI=rediss://default:xxx@xxx.upstash.io:6379
# UPSTASH_REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# === OBSERVABILITY (optional) ===
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# OTEL_EXPORTER_OTLP_ENDPOINT=

# === INDIA MAPS AND CALENDAR ===
# GOOGLE_MAPS_API_KEY=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# === UPLOADS ===
# Local disk is used when S3/R2 is unset.
# S3_BUCKET=
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto

# === VOICE (optional Whisper). Browser speech works without this. ===
# OPENAI_API_KEY=

# === WORKER ===
# Required in production for POST /api/worker/run
# WORKER_WEBHOOK_SECRET=

# === TELEGRAM ===
# Bot: https://t.me/bloom531134_bot
# Webhook: https://dwa21x631l5fr.cloudfront.net/api/telegram
# TELEGRAM_BOT_TOKEN=